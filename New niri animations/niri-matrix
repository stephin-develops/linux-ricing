animations {
    window-open {
        spring damping-ratio=1.0 stiffness=300 epsilon=0.0001
        custom-shader r"
        float hash(vec2 co) {
            return fract(sin(dot(co.xy ,vec2(12.9898,78.233))) * 43758.5453);
        }
        vec4 open_color(vec3 coords_geo, vec3 size_geo) {
            float p = niri_clamped_progress;
            vec2 mosaic_resolution = vec2(48.0, 27.0);
            vec2 cell_coords = floor(coords_geo.xy * mosaic_resolution);
            vec2 cell_min = cell_coords / mosaic_resolution;
            vec2 cell_center = (cell_coords + 0.5) / mosaic_resolution;
            vec2 radial_vec = cell_center - 0.5;
            float radial_dist = length(radial_vec);
            float cell_rand = hash(cell_coords);
            float appearance_threshold = radial_dist / 0.707 + cell_rand * 0.1;
            float cell_active = smoothstep(0.0, 0.1, p - appearance_threshold * 0.8);
            vec2 internal_uv = (coords_geo.xy - cell_min) * mosaic_resolution;
            vec2 centered_internal_uv = internal_uv - 0.5;
            centered_internal_uv /= mix(0.01, 1.0, cell_active);
            centered_internal_uv += radial_vec * mix(0.15, 0.0, cell_active);
            float max_angle = (cell_rand - 0.5) * 3.14159 * 2.0;
            float angle = mix(max_angle, 0.0, cell_active);
            float cos_angle = cos(angle);
            float sin_angle = sin(angle);
            mat2 rotation_matrix = mat2(cos_angle, -sin_angle, sin_angle, cos_angle);
            centered_internal_uv = rotation_matrix * centered_internal_uv;
            vec2 new_internal_uv = centered_internal_uv + 0.5;
            vec2 new_geo_uv = new_internal_uv / mosaic_resolution + cell_min;
            if (new_internal_uv.x < 0.0 || new_internal_uv.x > 1.0 || new_internal_uv.y < 0.0 || new_internal_uv.y > 1.0) {
                cell_active = 0.0;
            }
            vec3 coords_tex = niri_geo_to_tex * vec3(new_geo_uv, coords_geo.z);
            vec4 oColor = texture2D(niri_tex, coords_tex.st);
            float cell_corner_radius = 4.0;
            vec2 pixel_pos_cell = centered_internal_uv * (size_geo.xy / mosaic_resolution);
            vec2 box_size_cell = (size_geo.xy / mosaic_resolution) * 0.5;
            float radius_cell = min(cell_corner_radius, min(box_size_cell.x, box_size_cell.y));
            vec2 q_cell = abs(pixel_pos_cell) - box_size_cell + vec2(radius_cell);
            float dist_cell = length(max(q_cell, 0.0)) + min(max(q_cell.x, q_cell.y), 0.0) - radius_cell;
            float mask_cell = 1.0 - smoothstep(-0.5, 0.5, dist_cell);
            float global_alpha = p;
            return oColor * mask_cell * cell_active * global_alpha;
        }
        "
    }

    window-close {
        spring damping-ratio=1.0 stiffness=300 epsilon=0.0001
        custom-shader r"
        float hash(vec2 co) {
            return fract(sin(dot(co.xy ,vec2(12.9898,78.233))) * 43758.5453);
        }
        vec4 close_color(vec3 coords_geo, vec3 size_geo) {
            float p = 1.0 - niri_clamped_progress;
            vec2 mosaic_resolution = vec2(48.0, 27.0);
            vec2 cell_coords = floor(coords_geo.xy * mosaic_resolution);
            vec2 cell_min = cell_coords / mosaic_resolution;
            vec2 cell_center = (cell_coords + 0.5) / mosaic_resolution;
            vec2 radial_vec = cell_center - 0.5;
            float radial_dist = length(radial_vec);
            float cell_rand = hash(cell_coords);
            float disappearance_threshold = radial_dist / 0.707 + cell_rand * 0.1;
            float cell_active = smoothstep(-0.1, 0.0, p - disappearance_threshold * 0.8);
            vec2 internal_uv = (coords_geo.xy - cell_min) * mosaic_resolution;
            vec2 centered_internal_uv = internal_uv - 0.5;
            centered_internal_uv /= mix(0.01, 1.0, cell_active);
            centered_internal_uv += radial_vec * mix(0.15, 0.0, cell_active);
            float max_angle = (cell_rand - 0.5) * 3.14159 * 2.0;
            float angle = mix(max_angle, 0.0, cell_active);
            float cos_angle = cos(angle);
            float sin_angle = sin(angle);
            mat2 rotation_matrix = mat2(cos_angle, -sin_angle, sin_angle, cos_angle);
            centered_internal_uv = rotation_matrix * centered_internal_uv;
            vec2 new_internal_uv = centered_internal_uv + 0.5;
            vec2 new_geo_uv = new_internal_uv / mosaic_resolution + cell_min;
            if (new_internal_uv.x < 0.0 || new_internal_uv.x > 1.0 || new_internal_uv.y < 0.0 || new_internal_uv.y > 1.0) {
                cell_active = 0.0;
            }
            vec3 coords_tex = niri_geo_to_tex * vec3(new_geo_uv, coords_geo.z);
            vec4 oColor = texture2D(niri_tex, coords_tex.st);
            float cell_corner_radius = 4.0;
            vec2 pixel_pos_cell = centered_internal_uv * (size_geo.xy / mosaic_resolution);
            vec2 box_size_cell = (size_geo.xy / mosaic_resolution) * 0.5;
            float radius_cell = min(cell_corner_radius, min(box_size_cell.x, box_size_cell.y));
            vec2 q_cell = abs(pixel_pos_cell) - box_size_cell + vec2(radius_cell);
            float dist_cell = length(max(q_cell, 0.0)) + min(max(q_cell.x, q_cell.y), 0.0) - radius_cell;
            float mask_cell = 1.0 - smoothstep(-0.5, 0.5, dist_cell);
            float global_alpha = p;
            return oColor * mask_cell * cell_active * global_alpha;
        }
        "
    }

    window-resize {
        spring damping-ratio=1.0 stiffness=300 epsilon=0.0001
    }
    workspace-switch {
        spring damping-ratio=1.0 stiffness=300 epsilon=0.0001
    }
    horizontal-view-movement {
        spring damping-ratio=1.0 stiffness=300 epsilon=0.0001
    }
    window-movement {
        spring damping-ratio=1.0 stiffness=300 epsilon=0.0001
    }
    overview-open-close {
        spring damping-ratio=1.0 stiffness=300 epsilon=0.0001
    }
    config-notification-open-close {
        duration-ms 200
        curve "ease-out-expo"
    }
    exit-confirmation-open-close {
        duration-ms 200
        curve "ease-out-expo"
    }
    screenshot-ui-open {
        duration-ms 200
        curve "ease-out-expo"
    }
    recent-windows-close {
        duration-ms 200
        curve "ease-out-expo"
    }
}
